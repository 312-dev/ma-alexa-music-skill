# Required. The https:// origin Amazon can reach this service on. Every stream
# and cover-art URL Amazon fetches is built from it, so a wrong value fails at
# playback rather than at startup, with nothing in any log to explain it.
PUBLIC_BASE=https://music.example.com

# Required. Your Subsonic-compatible server, reachable from this service.
SUBSONIC_URL=http://navidrome.internal:4533
SUBSONIC_USER=alexa
SUBSONIC_PASSWORD=

# Required. Signs the expiring /stream and /art URLs handed to Amazon, and the
# setup session cookie. Any long random string: openssl rand -hex 32
SIGNING_KEY=

# Required to reach /setup, /diag and /captures at all. Without it /setup
# refuses to serve rather than serving open.
ADMIN_TOKEN=

# Optional. What plays once the requested content runs out:
# stop, artist, genre, library, radio.
AFTER_CONTENT=stop

# Optional. Station shape.
RADIO_ARTISTS=12
RADIO_TRACKS_PER_ARTIST=12

# Optional. Inbound Amazon request verification: off, warn, on.
# Starts at warn so a working deployment is not broken silently. Watch a day of
# real traffic verify in the log, then set on.
VERIFY_REQUESTS=warn

# Optional. Needed only so the catalog sync can rebind the skill after an
# upload. Without it an upload silently unbinds the skill and voice playback
# falls back to your default music provider.
SKILL_ID=
SKILL_STAGE=development
