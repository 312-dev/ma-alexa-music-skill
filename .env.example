# Required. The https:// origin Amazon can reach this service on. Every stream
# and cover-art URL Amazon fetches is built from it, so a wrong value fails at
# playback rather than at startup, with nothing in any log to explain it.
PUBLIC_BASE=https://music.example.com

# Required. Your Subsonic-compatible server, reachable from this service.
SUBSONIC_URL=http://navidrome.internal:4533
SUBSONIC_USER=alexa
SUBSONIC_PASSWORD=

# Required. Signs the expiring /stream and /art URLs handed to Amazon, and the
# setup session cookie. Any long random string: openssl rand -hex 32
SIGNING_KEY=

# Required to reach /setup, /diag and /captures at all. Without it /setup
# refuses to serve rather than serving open.
ADMIN_TOKEN=

# Which networks the admin plane (/setup, /diag, /captures) answers on.
# "private" is loopback, RFC1918, link-local and CGNAT, which includes
# Tailscale's 100.64.0.0/10. Also takes "any", or a list of CIDRs.
#
# This service must be on the public internet because Amazon calls it. Setup
# must not be: it can create skills against your Amazon developer account and
# read your library, and Amazon never asks for it.
SETUP_ALLOW_NETWORKS=private

# If you reach setup through a reverse proxy, name the proxy here or every
# request will look like it came from the proxy and be judged on its address.
# X-Forwarded-For is only read when the immediate peer is listed, because
# otherwise anyone could set that header and claim to be on your LAN.
TRUSTED_PROXIES=

# Failed logins per address before that address is locked out, and for how
# long. The admin token is a single shared secret, so without this it can be
# guessed at whatever rate the network allows.
SETUP_LOCKOUT_THRESHOLD=5
SETUP_LOCKOUT_SECONDS=900

# Optional. What plays once the requested content runs out:
# stop, artist, genre, library, radio.
AFTER_CONTENT=stop

# Optional. Station shape.
RADIO_ARTISTS=12
RADIO_TRACKS_PER_ARTIST=12

# Optional. Inbound Amazon request verification: off, warn, on.
# Starts at warn so a working deployment is not broken silently. Watch a day of
# real traffic verify in the log, then set on.
VERIFY_REQUESTS=warn

# Optional. Needed only so the catalog sync can rebind the skill after an
# upload. Without it an upload silently unbinds the skill and voice playback
# falls back to your default music provider.
SKILL_ID=
SKILL_STAGE=development

# How stale the skill's enablement may get before the keep-alive re-provisions
# it. The provider-slot binding decays on its own, within hours, while Amazon
# still reports the skill as enabled and searches still resolve; the only
# symptom is that nothing plays. Four is an extrapolation from two
# observations. The Status page counts how many recent searches reached
# playback: lower this until that stops showing misses. 0 disables it.
BINDING_KEEPALIVE_HOURS=4

# Optional. Retention. Captures are the only diagnostic a music skill has, but
# nothing here needs a year of them. 0 on either disables that pruning.
CAPTURE_KEEP=400
QUEUE_STATE_TTL=604800

# Advertise <name>.local on the LAN so setup can be reached by name instead of
# by address, the way homeassistant.local works. Off by default because it
# cannot work by default: mDNS is link-local multicast, so it needs
# network_mode: host. On a bridge network the container's address is not
# routable from your LAN and the bridge will refuse to advertise it rather than
# publish a name that resolves and then times out.
MDNS=0
MDNS_NAME=ampere

# Only needed if your Amazon developer account has more than one vendor. The
# wizard refuses to guess rather than put the skill somewhere you did not pick.
VENDOR_ID=
